<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:padding="3dp"
            android:background="@drawable/widget_logo_tile"
            android:src="@drawable/widget_ic_home"
            android:tint="@color/widget_on_primary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:text="HouseKeep"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_badge_pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_badge_pending"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_badge_pending_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_badge_soon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_badge_soon"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_badge_soon_text"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_state_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_state_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_events_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_event_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:contentDescription="@null"
                    android:id="@+id/widget_event_0_stripe"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:background="@color/widget_stripe_upcoming" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_event_0_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_event_0_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_event_0_due"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/widget_chip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_accent" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_event_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_event_1_stripe"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_event_1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/widget_event_1_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/widget_event_1_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_event_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_event_2_stripe"
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_event_2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/widget_event_2_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/widget_event_2_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
